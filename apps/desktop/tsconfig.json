{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": ["es2023", "dom"],
    "types": ["node"]
  },
  "include": ["electron", "shared", "scripts/*.ts"]
}
