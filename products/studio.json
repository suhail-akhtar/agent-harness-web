{
  "id": "studio",
  "name": "Harness Studio",
  "appId": "dev.harness.studio",
  "description": "The agent harness with Studio: games and 3D (Blender, Godot, Unity, Unreal) on your desktop.",
  "brand": {
    "icon": "assets/harness.png",
    "accent": "#d97757",
    "wordmark": "Harness Studio",
    "tagline": "What shall we make?"
  },
  "solutions": [
    "studio"
  ],
  "plugins": {
    "bundled": [
      "core.*"
    ],
    "enabled": [
      "core.*"
    ],
    "required": [
      "core.chat",
      "core.settings",
      "core.plugins"
    ]
  },
  "nav": {
    "order": [
      "core.chat:new",
      "core.chat:search",
      "core.inbox:inbox",
      "core.activity:activity",
      "core.projects:projects",
      "core.plugins:plugins"
    ]
  },
  "home": {
    "cards": [
      "core.inbox:attention",
      "core.chat:recent"
    ]
  },
  "trustedKeys": [
    "keys/suhail-akhtar.pub.pem"
  ],
  "policy": {
    "lock": {},
    "defaults": {}
  },
  "server": {
    "mode": "local",
    "solutions": [
      "games3d",
      "engine-blender",
      "engine-godot",
      "engine-unity",
      "engine-unreal"
    ]
  }
}
