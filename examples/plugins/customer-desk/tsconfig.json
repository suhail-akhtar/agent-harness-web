{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["es2023", "dom"],
    "types": ["node"],
    "typeRoots": ["../../../node_modules/@types"],
    "paths": {
      "@harness/plugin-sdk": ["../../../packages/plugin-sdk/src/index.ts"],
      "@harness/plugin-sdk/*": ["../../../packages/plugin-sdk/src/*.ts"]
    }
  },
  "include": ["*.ts", "lib/**/*.ts", "test/**/*.ts"]
}
