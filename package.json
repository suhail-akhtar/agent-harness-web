{
  "name": "harness-web",
  "version": "0.2.5",
  "private": true,
  "description": "A browser-based agent harness: one model-driven loop, cache-first context, sandboxed tools.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "plugins",
    "solutions/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/run.mjs src/server/main.ts",
    "dev": "npm run build && npm start",
    "cli": "node scripts/run.mjs src/cli.ts",
    "bench": "node scripts/run.mjs bench/run.ts",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit && tsc -p packages/ui/tsconfig.json --noEmit && tsc -p apps/desktop/tsconfig.json --noEmit && tsc -p apps/desktop/renderer/tsconfig.json --noEmit",
    "sandbox:image": "docker build -t harness-sandbox:latest -f docker/Dockerfile.sandbox docker",
    "sandbox:image:3d": "docker build -t harness-sandbox-3d:latest -f docker/Dockerfile.sandbox-3d docker",
    "sandbox:image:3d-export": "docker build -t harness-sandbox-3d:export --build-arg=GODOT_EXPORT_TEMPLATES=1 -f docker/Dockerfile.sandbox-3d docker",
    "sandbox:image:desktop": "docker build -t harness-sandbox-desktop:latest -f docker/Dockerfile.sandbox-desktop docker",
    "sandbox:image:ops": "docker build -t harness-sandbox-ops:latest -f docker/Dockerfile.sandbox-ops docker",
    "eval": "node scripts/run.mjs src/eval/cli.ts",
    "plugin": "node scripts/run.mjs src/plugins/cli.ts",
    "plugins:bundles": "node scripts/run.mjs src/plugins/cli.ts bundles",
    "users": "node scripts/run.mjs src/server/users-cli.ts",
    "desktop:dev": "node apps/desktop/scripts/dev.mjs",
    "desktop:build": "node apps/desktop/scripts/package.mjs",
    "desktop:test": "npm run test:e2e -w @harness/desktop",
    "postinstall": "node scripts/ensure-electron.mjs && node scripts/ensure-duckdb.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@duckdb/node-api": "1.5.6-r.1",
    "preact": "^11.0.1",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "docx": "9.13.0",
    "marked": "18.0.14",
    "mongodb": "7.7.0",
    "mysql2": "3.24.5",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.1",
    "playwright-core": "1.56.1",
    "pptxgenjs": "4.0.1",
    "tedious": "20.3.5",
    "three": "0.186.1"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
