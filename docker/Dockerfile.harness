# The harness itself in a Linux container: the server, the CLI, tests and
# evaluations, with everything the visual tools need (LibreOffice, poppler,
# pandoc, Chromium). The way to run harness-web on Windows or macOS without
# installing any of it on the machine. See docker-compose.yml.
FROM node:22-bookworm
ARG EXTRA_CA=""
ARG PLAYWRIGHT_VERSION=1.56.1
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers \
    PIP_BREAK_SYSTEM_PACKAGES=1
RUN set -eux; \
    if [ -n "$EXTRA_CA" ]; then printf '%s\n' "$EXTRA_CA" > /usr/local/share/ca-certificates/extra.crt; fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates git ripgrep jq procps less python3 python3-pip python3-venv util-linux \
      libreoffice-writer libreoffice-impress libreoffice-calc \
      poppler-utils pandoc fonts-dejavu fonts-liberation fonts-noto-core; \
    update-ca-certificates; \
    npx -y "playwright-core@${PLAYWRIGHT_VERSION}" install --with-deps chromium; \
    rm -rf /var/lib/apt/lists/* /root/.npm; \
    git config --system init.defaultBranch main; \
    git config --system --add safe.directory '*'
WORKDIR /app
EXPOSE 4310
CMD ["npm", "start"]
